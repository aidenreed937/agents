  "gate_thresholds": {
    "routing_overall_acc_min": 0.90,
    "routing_fast_f1_min": 0.90,
    "routing_path_match_min": 0.95,
    "hit_rate_at_1_min": 0.75,
    "hit_rate_at_3_min": 0.85,
    "mrr_min": 0.80,
    "rerank_retention_min": 0.90,
    "grounded_citation_min": 0.95,
    "out_of_domain_refusal_min": 1.00
  }
}
