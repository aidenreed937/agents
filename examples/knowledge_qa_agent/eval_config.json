{
  "paths": {
    "default_dataset": "eval_data/golden_dataset.json",
    "data_dir": "data",
    "history_dir": "eval_history",
    "default_report": "reports/benchmark_report.md"
  },
  "retrieval": {
    "top_k_candidates": 6,
    "top_n_rerank": 3,
    "rrf_k": 60,
    "min_relevance_threshold": 0.22,
