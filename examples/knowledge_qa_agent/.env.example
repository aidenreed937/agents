# =============================================================================
# 知识库与控制台 Agent 大模型环境配置模板 (.env)
# 复制此文件为 .env 即可生效：cp .env.example .env
# =============================================================================

# 1. 目标模型配置 (Model Name)
# 安装 litellm (pip install litellm) 后，支持各厂商标准前缀：
# - OpenAI: gpt-4o, gpt-4o-mini
# - DeepSeek: deepseek/deepseek-chat, deepseek/deepseek-reasoner
# - Anthropic: claude-3-5-sonnet-20240620, claude-3-opus-20240229
# - Google Gemini: gemini/gemini-1.5-pro, gemini/gemini-1.5-flash
# - 本地 Ollama: ollama/qwen2.5:7b, ollama/llama3.1
# - 本地/私有部署 vLLM: openai/qwen2.5-72b
LLM_MODEL=gpt-4o-mini

# 2. 身份认证密钥 (API Key)
# 支持通用变量名 LLM_API_KEY，或对应平台的标准变量名：
# - OPENAI_API_KEY=sk-...
# - ANTHROPIC_API_KEY=sk-ant-...
# - GEMINI_API_KEY=AIza...
# - DEEPSEEK_API_KEY=sk-...
OPENAI_API_KEY=your_api_key_here

# 3. 自定义接口服务端点 (Base URL)
# 适用于自建网关、中转服务、DeepSeek 或私有化部署的 vLLM / Ollama：
# - DeepSeek 官方端点: https://api.deepseek.com/v1
# - 本地 vLLM 服务: http://localhost:8000/v1
# - 本地 Ollama 服务: http://localhost:11434/v1
# - 企业统一网关: https://gateway.internal.corp/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# 4. 思考强度与思维链预算配置 (Reasoning Effort & Thinking Budget)
# 针对推理模型 (如 OpenAI o1/o3-mini, Claude 3.7 Extended Thinking, DeepSeek-R1) 控制思考深度：
# - 离散档位 (OpenAI / LiteLLM 统一抽象): low (极速/低成本), medium (均衡), high (深度排障), off/none (关闭思考)
LLM_REASONING_EFFORT=low
# - 显式 Token 预算上限 (适用于 Claude 3.7 / Gemini Thinking 等):
# LLM_THINKING_BUDGET=2048
